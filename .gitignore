# --- Proprietary game content: NEVER commit (see docs/roadmap/T00-repo-infra.md, T00-006) ---
/Serious Sam 2/
*.gro
*.dll
*.exe
*.wld
*.tex
*.mdl
*.bmf
*.ogv
*.xmv
*.chm
# ... except tiny hand-made fixtures under testdata/ (cargo xtask guard still checks them)
!testdata/**/*.tex
!testdata/**/*.bmf
# ... and the invented example mods (examples/mods/README.md; cargo xtask guard checks them too)
!examples/mods/**/*.tex

# Reverse-engineering workspaces (notes go in docs/re/, never decompiler output)
*.gpr
*.rep/
ghidra_projects/
decompiled/

# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Local / editor
.vs/
.idea/
.vscode/
.claude/
*.log
.codegraph/

# SDD scratch workspace
.superpowers/

# Python bytecode from the tools/re scripts
__pycache__/
*.pyc

# cargo-fuzz (docs/FUZZING.md): build output, corpora and crash inputs are never committed
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Throwaway spikes (spikes/*/README.md): build output is never committed
/spikes/*/target/
